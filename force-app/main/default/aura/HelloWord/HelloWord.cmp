<aura:component implements="flexiPage:availableForAllPageTypes,force:appHostable" access="global">
    <aura:attribute name="whom" type="string" access="global" default="worldd"/>
	<h1 class="title">Hellooooooooooooooo {!v.whom}!</h1>
    <ui:inputSelect class="single" aura:id="InputSelectSingle" change="{!c.onSingleSelectChange}">

            <ui:inputSelectOption text="vijay"/>
            <ui:inputSelectOption text="prashanth" value="true"/>
            <ui:inputSelectOption text="shankar"/>
            <ui:inputSelectOption text="bhaskar"/>
        	
    </ui:inputSelect>
</aura:component>