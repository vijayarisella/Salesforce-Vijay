<apex:page controller="PieChartController" title="Pie Chart" showHeader="false" >
    <table border="2" height="100%" width="100%">
    <tbody>
    <tr>
        <td>
            <apex:chart height="350" width="450" data="{!pieData}">
                <apex:pieSeries dataField="data" labelField="name">
                    <apex:chartTips height="75" width="200" rendererFn="renderChartTip"/>
                </apex:pieSeries>
                <apex:legend position="right"/>
            </apex:chart>
        </td>
        
        <td>
            <apex:chart height="350" width="450" data="{!pieData}">
                <apex:pieSeries dataField="data" labelField="name">
                    <apex:chartTips height="75" width="200" rendererFn="renderChartTip"/>
                </apex:pieSeries>
                <apex:legend position="right"/>
            </apex:chart>
        </td>
    </tr>
        
        <tr>
            <td>
                <apex:chart height="350" width="450" data="{!pieData}">
                    <apex:pieSeries dataField="data" labelField="name">
                        <apex:chartTips height="75" width="200" rendererFn="renderChartTip"/>
                    </apex:pieSeries>
                    <apex:legend position="right"/>
                </apex:chart>
            </td>
        
            <td>
                <apex:chart height="350" width="450" data="{!pieData}">
                    <apex:pieSeries dataField="data" labelField="name">
                        <apex:chartTips height="75" width="200" rendererFn="renderChartTip"/>
                    </apex:pieSeries>
                    <apex:legend position="right"/>
                </apex:chart>
            </td>
        </tr>
        </tbody>
        </table>

<script>
function renderChartTip(klass, item) {
    var m = item.storeItem;
    this.setTitle(m.get('name'));
    this.update(''
            + '<table>'
            + '<tr><td><b>Data</b>&nbsp;</td><td>' + m.get('data') + '</td></tr>'
            + '<tr><td><b>Other 1</b>&nbsp;</td><td>' + m.get('other1') + '</td></tr>'
            + '<tr><td><b>Other 2</b>&nbsp;</td><td>' + m.get('other2') + '</td></tr>'
            + '</table>'
            );
}
</script>

</apex:page>