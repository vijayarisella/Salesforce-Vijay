    <script>
    function toggleChevron(e) {
    $(e.target)
        .prev('.panel-heading')
        .find("span.indicator")
        .toggleClass('glyphicon glyphicon-plus glyphicon glyphicon-minus');
    }
    $('#accordion').on('hidden.bs.collapse', toggleChevron);
    $('#accordion').on('shown.bs.collapse', toggleChevron);
        </script>
    
